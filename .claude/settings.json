{
  "permissions": {
    "allow": [
      "Bash(bash bin/kuru *)",
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git apply*)",
      "Bash(git add -N*)",
      "Bash(git -C * diff*)",
      "Bash(git -C * status*)",
      "Bash(git -C * add -N*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/end-of-task.sh\""
          }
        ]
      }
    ]
  }
}
